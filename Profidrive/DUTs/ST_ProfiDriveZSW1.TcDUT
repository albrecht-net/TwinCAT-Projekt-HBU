<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_ProfiDriveZSW1" Id="{22446589-42c5-4c92-8aa6-d6053531d6b8}">
    <Declaration><![CDATA[TYPE ST_ProfiDriveZSW1 :
STRUCT
    // Power supply switched on; electronics initialized; pulses locked.
    ReadyToSwitchOn : BIT;
    //  Motor is switched on (ON/OFF1 = 1), no fault is active.
    ReadyToOperate : BIT;
    // Motor follows setpoint.
    OperationEnabled : BIT;
    // The converter has a fault.
    FaultPresent : BIT;
    // Coast down to standstill is not active.
    NoCoastStopActivated : BIT;
    // Quick stop is not active.
    NoQuickStopActivated : BIT;
    //  It is only possible to switch on the motor after an OFF1 followed by ON.
    SwitchingOnInhibited : BIT;
    // Motor remains switched on; no acknowledgement is necessary.
    AlarmPresent : BIT;
    // Setpoint / actual value deviation within the tolerance range.
    NoSpeedDeviation : BIT;
    // The automation system is requested to accept the converter control.
    ControlRequested : BIT;
    // Speed is greater than or equal to the corresponding maximum speed.
    SpeedComparisonValueExeeded : BIT;
    // Holding brake open
    MotorBrakeActive : BIT;
    // No alarm, motor overtemperature
    NoAlarmOvertemperature : BIT;
    ReservedBit13 : BIT;
    // Motor rotates clockwise
    DirectionCW : BIT;
    // CDS display. 0: Alarm, converter thermal overload.
    CdsDisplay : BIT;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>