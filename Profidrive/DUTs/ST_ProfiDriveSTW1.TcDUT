<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_ProfiDriveSTW1" Id="{497062ff-0b65-41c2-b58a-10b61809b5e1}">
    <Declaration><![CDATA[TYPE ST_ProfiDriveSTW1 :
STRUCT
    // The converter goes into the "ready" state.
    On : BIT;
    // The motor can be switched on (ON command). 0: motor coasts down to a standstill.
    NoCoastStop : BIT;
    // The motor can be switched on (ON command). 0: ramp-down time p1135 down to standstill.
    NoQuickStop : BIT;
    // Switch-on motor (pulses can be enabled).
    EnableOperation : BIT;
    // The ramp-function generator can be enabled.
    NotDisableRampGenerator : BIT;
    // The output of the ramp-function generator follows the setpoint.
    EnableRampeGenerator : BIT;
    // Motor accelerates with the ramp-up time p1120 to the setpoint.
    EnableSetpoint : BIT;
    // Acknowledge fault.
    FaultAcknowledge : BIT;
    ReservedBit08 : BIT;
    ReservedBit09 : BIT;
    // Control via fieldbus, converter accepts the process data from the fieldbus.
    ControlByPlc : BIT;
    // Invert setpoint in the converter.
    ReverseDirection : BIT;
    NotUsedBit12 : BIT;
    // Increase the setpoint saved in the motorized potentiometer.
    IncreaseMop : BIT;
    // Reduce the setpoint saved in the motorized potentiometer.
    DecreaseMop : BIT;
    ReservedBit16 : BIT;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>